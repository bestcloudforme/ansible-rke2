! {{ ansible_managed }}
! Keepalived configuration for RKE2 HA

global_defs {
    enable_script_security
    script_user root
}

vrrp_script check_apiserver {
    script "{{ keepalived_check_script_path }}"
    interval {{ keepalived_check_interval }}
    fall {{ keepalived_check_fall }}
    rise {{ keepalived_check_rise }}
}

vrrp_instance RKE2_VIP {
    ! Every node starts as BACKUP and priority decides who takes the VIP. A
    ! hardcoded MASTER re-claims the address on boot even when its HAProxy is
    ! not serving yet.
    state BACKUP
    interface {{ keepalived_vrrp_interface }}
    virtual_router_id {{ keepalived_vrrp_id }}
    priority {{ keepalived_priority }}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    unicast_src_ip {{ keepalived_unicast_src_ip }}
    unicast_peer {
{% for host in groups['loadbalancers'] %}
{% if host != inventory_hostname %}
        {{ hostvars[host]['ansible_facts']['default_ipv4']['address'] | default(hostvars[host]['ansible_host'] | default(host, true), true) }}
{% endif %}
{% endfor %}
    }

    virtual_ipaddress {
        {{ rke2_lb_vip }}/32
    }

    ! No weight: a failing check puts the instance into FAULT and releases the
    ! VIP outright. A small negative weight only nudges the priority, and with
    ! evenly spaced priorities both nodes can end up tied.
    track_script {
        check_apiserver
    }
}
