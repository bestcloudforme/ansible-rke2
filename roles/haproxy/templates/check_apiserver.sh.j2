#!/bin/bash
# {{ ansible_managed }}
# keepalived health check.
#
# This decides which load balancer owns the VIP, so it answers one question:
# can HAProxy on THIS node accept traffic? Backend health is HAProxy's job - it
# already drops unhealthy masters from the pool. Probing backends here would tie
# the VIP to cluster state and deadlock a fresh install: during bootstrap no
# master exists, every node would report FAULT, and no node would hold the VIP
# the first master has to be reached through.
#
# Uses nothing but bash builtins on purpose. keepalived runs check scripts in a
# stripped environment where external binaries are not reliably callable, and
# pidof/systemctl live in different packages on different distributions.

set -u

errorExit() {
    echo "*** $*" 1>&2
    exit 1
}

for port in {{ haproxy_api_frontend_port }} {{ haproxy_join_frontend_port }}; do
    (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null \
        || errorExit "HAProxy is not accepting connections on ${port}"
done
