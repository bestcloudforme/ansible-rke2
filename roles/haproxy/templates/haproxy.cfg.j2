# {{ ansible_managed }}
# HAProxy configuration for RKE2 HA cluster

global
    log         /dev/log local0
    log         /dev/log local1 notice
    chroot      /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user        haproxy
    group       haproxy
    daemon
    maxconn     {{ haproxy_maxconn }}

defaults
    mode                    tcp
    log                     global
    option                  tcplog
    option                  dontlognull
    option                  redispatch
    retries                 {{ haproxy_retries }}
    timeout queue           1m
    timeout connect         10s
    timeout client          {{ haproxy_timeout_client }}
    timeout server          {{ haproxy_timeout_server }}
    timeout tunnel          {{ haproxy_timeout_tunnel }}
    timeout check           10s
    default-server init-addr last,libc,none

#---------------------------------------------------------------------
# Stats page
#---------------------------------------------------------------------
listen stats
    bind {{ haproxy_stats_bind }}:{{ haproxy_stats_port }}
    mode http
    stats enable
    stats uri /stats
    stats refresh 10s
    stats admin if LOCALHOST
    stats auth {{ haproxy_stats_user }}:{{ haproxy_stats_password }}

#---------------------------------------------------------------------
# Kubernetes API server - port {{ haproxy_api_frontend_port }}
#---------------------------------------------------------------------
frontend k8s_api
    bind *:{{ haproxy_api_frontend_port }}
    mode tcp
    option tcplog
    default_backend k8s_api_backend

backend k8s_api_backend
    mode tcp
    balance {{ haproxy_balance_algorithm }}
    # A TCP connect only proves the port is open. /readyz proves the apiserver
    # is serving. RKE2 runs the apiserver with anonymous-auth=false, so an
    # unauthenticated probe is answered with 401 - which still means healthy.
    option httpchk GET /readyz
    http-check expect rstatus ^(2..|401|403)$
{% for host in groups['masters'] %}
    server {{ host }} {{ hostvars[host]['ansible_facts']['default_ipv4']['address'] | default(hostvars[host]['ansible_host'] | default(host, true), true) }}:6443 check check-ssl verify none inter {{ haproxy_check_interval }} fall {{ haproxy_check_fall }} rise {{ haproxy_check_rise }}
{% endfor %}

#---------------------------------------------------------------------
# RKE2 supervisor / join API - port {{ haproxy_join_frontend_port }}
#---------------------------------------------------------------------
frontend rke2_join
    bind *:{{ haproxy_join_frontend_port }}
    mode tcp
    option tcplog
    default_backend rke2_join_backend

backend rke2_join_backend
    mode tcp
    balance {{ haproxy_balance_algorithm }}
    option httpchk GET /ping
    http-check expect status 200
{% for host in groups['masters'] %}
    server {{ host }} {{ hostvars[host]['ansible_facts']['default_ipv4']['address'] | default(hostvars[host]['ansible_host'] | default(host, true), true) }}:9345 check check-ssl verify none inter {{ haproxy_check_interval }} fall {{ haproxy_check_fall }} rise {{ haproxy_check_rise }}
{% endfor %}
