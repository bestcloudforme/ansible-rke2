{# Cilium HelmChartConfig for RKE2 #}
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-cilium
  namespace: kube-system
spec:
  valuesContent: |-
{% if rke2_cilium_kube_proxy_replacement | default(true) | bool %}
    kubeProxyReplacement: true
    {# Every RKE2 node reaches the apiserver on its own loopback, through the
       agent load balancer. Pointing this at the VIP makes the CNI depend on the
       load balancer, and with kube-vip it deadlocks: Cilium waits for an address
       that kube-vip cannot advertise until Cilium is up. #}
    k8sServiceHost: "127.0.0.1"
    k8sServicePort: "6443"
{% endif %}
{% if rke2_cilium_bpf_masquerade | default(true) | bool %}
    bpf:
      masquerade: true
{% endif %}
    operator:
      replicas: {{ 2 if (rke2_master_count | int > 1) else 1 }}
