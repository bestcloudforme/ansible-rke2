---
profile: basic

warn_list:
  - yaml[truthy]
  - name[casing]
  - no-changed-when
  # register/set_fact names are shared across roles here (the join token, the
  # bootstrap flag), so a per-role prefix would be misleading.
  - var-naming[no-role-prefix]

exclude_paths:
  - .github/
  - .ansible/
